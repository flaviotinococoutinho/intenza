{
  "experiment": {
    "id": "psp-latency-tail",
    "title": "Agente de custódia lento e instável",
    "risk": "psp-latency-tail",
    "claims": [
      "psp-calls-bounded"
    ],
    "hypothesis": "Com o agente de custódia em cauda lognormal (mediana 800 ms, sigma 1) e 30% de 503, o p99 de publicação e de proposta fica abaixo de 1 s e os acordos ainda chegam à liberação.",
    "cause": "Latência e erros injetados no simulador do agente.",
    "mechanism": "A saga é assíncrona; cada chamada tem prazo, disjuntor por taxa de falha e retentativa com jitter, então a lentidão fica no worker.",
    "expected_effect": "A liquidação atrasa e o disjuntor pode abrir; quem publica e propõe não sente.",
    "load": {
      "rate": 0.4,
      "sellers": 6,
      "propose_p": 0.6,
      "window": "PT12S",
